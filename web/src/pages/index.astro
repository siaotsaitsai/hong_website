---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Layout title="Home" page="home">
  <section class="home-heading"><span class="eyebrow">PAINTINGS / SELECTED WORKS</span><p>A practice<br/>in <em>looking.</em></p><span class="heading-aside">An exploration of color,<br/>memory, and the everyday.</span></section>
  <section id="home-artwork" aria-label="Featured artwork" aria-busy="true"></section>
  <section class="home-note"><p>Small observations.<br/>An open-ended conversation.</p><a class="text-link" href={`${base}works/`}>Explore selected works <span><svg class="arrow" aria-hidden="true" viewBox="0 0 16 16" fill="none"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.2"/></svg></span></a></section>
</Layout>
