---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Layout title="Home" page="home">
  <section id="home-artwork" aria-label="Featured artwork" aria-busy="true"></section>
  <section class="home-note"><a class="text-link" href={`${base}works/`}>Explore portfolio <span><svg class="arrow" aria-hidden="true" viewBox="0 0 16 16" fill="none"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.2"/></svg></span></a></section>
</Layout>
