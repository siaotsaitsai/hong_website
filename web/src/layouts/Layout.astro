---
import '../styles/global.css';
import {getShareImage} from '../lib/server/shareImage';
import {websiteUrl} from '../../../shared/websiteUrl';
const {title, page} = Astro.props;
const shareTitle = page === 'home' ? 'Hong Yang' : `${title} — Hong Yang`;
const shareDescription = '';
const shareImage = await getShareImage();
const canonicalUrl = new URL(Astro.url.pathname,websiteUrl).href;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={shareDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Hong Yang" />
  <meta property="og:title" content={shareTitle} />
  <meta property="og:description" content={shareDescription} />
  <meta property="og:url" content={canonicalUrl} />
  <link rel="canonical" href={canonicalUrl} />
  {shareImage && <>
    <meta property="og:image" content={shareImage.url} />
    <meta property="og:image:secure_url" content={shareImage.url} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={shareImage.alt} />
    {shareImage.width && <meta property="og:image:width" content={String(shareImage.width)} />}
    {shareImage.height && <meta property="og:image:height" content={String(shareImage.height)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage.url} />
    <meta name="twitter:title" content={shareTitle} />
    <meta itemprop="image" content={shareImage.thumbnailUrl || shareImage.url} />
    <link rel="image_src" href={shareImage.thumbnailUrl || shareImage.url} />
  </>}
  <meta name="theme-color" content="#ffffff" />
  <title>{shareTitle}</title>
  <link rel="icon" href={`${base}favicon-eyeshadow-v1.ico`} type="image/x-icon" sizes="16x16 32x32 48x48" />
  <link rel="icon" href={`${base}favicon-eyeshadow-v1-32.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}apple-touch-icon-eyeshadow-v1.png`} sizes="180x180" />
</head>
<body data-page={page}>
  {shareImage?.thumbnailUrl && <div class="share-thumbnail" aria-hidden="true"><img src={new URL(shareImage.thumbnailUrl).pathname} width="400" height="400" alt="" decoding="async" /></div>}
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="sidebar">
    <a class="wordmark" href={base} aria-label="Hong Yang, home" data-artist-name>Hong Yang</a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="navigation">Menu <span aria-hidden="true">＋</span></button>
    <nav id="navigation" aria-label="Main navigation">
      <a href={base} aria-current={page === 'home' ? 'page' : undefined}>Home</a>
      <a href={`${base}works/`} aria-current={page === 'works' ? 'page' : undefined}>Paintings <span aria-hidden="true"><svg width="11" height="11" class="arrow" aria-hidden="true" viewBox="0 0 16 16" fill="none"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.2"/></svg></span></a>
      <div id="series-nav"></div>
      <a href={`${base}cv/`} aria-current={page === 'cv' ? 'page' : undefined}>CV</a>
      <a href={`${base}artist-statement/`} aria-current={page === 'statement' ? 'page' : undefined}>Artist Statement</a>
      <a href={`${base}about/`} aria-current={page === 'about' ? 'page' : undefined}>About</a>
    </nav>
  </header>
  <main id="main" tabindex="-1">
    <div id="content-status" role="status" class="content-status" hidden></div>
    <noscript><p class="content-status">Please enable JavaScript to browse the artwork and artist information.</p></noscript>
    <slot />
    <footer><span>© {new Date().getFullYear()} <span data-artist-name>Hong Yang</span></span></footer>
  </main>
  <dialog id="artwork-dialog" aria-labelledby="lightbox-title">
    <div class="lightbox-top"><span class="eyebrow" id="lightbox-count"></span><button id="lightbox-close" aria-label="Close artwork">Close ×</button></div>
    <div class="lightbox-stage"><img id="lightbox-image" alt="" /><p id="image-error" hidden>This image could not be loaded.</p></div>
    <div class="lightbox-bottom"><div><h2 id="lightbox-title"></h2><p id="lightbox-details"></p><p id="lightbox-description"></p></div><div class="lightbox-controls"><button id="lightbox-prev" aria-label="Previous artwork">←</button><button id="lightbox-next" aria-label="Next artwork">→</button></div></div>
  </dialog>
  <script>import '../lib/site';</script>
</body>
</html>
